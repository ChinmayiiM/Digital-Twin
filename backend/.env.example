# Copy this file to backend/.env and fill in what you need. Never commit real keys.
DATABASE_URL=sqlite:///./twinmate.db

# ---- Optional LLM (Phase 4 What-If Simulator) ----
# Leave LLM_PROVIDER=none to run without any LLM: the simulator still works fully
# (rule-based question understanding + explanation generated from simulation results).
# The LLM only understands the question and words the explanation. It never calculates numbers.
#
# LLM_PROVIDER: none | anthropic | openai   (openai = any OpenAI-compatible API)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
# LLM_BASE_URL: only for OpenAI-compatible providers, e.g. https://api.example.com/v1
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=15
